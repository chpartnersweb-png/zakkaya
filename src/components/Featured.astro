---
import { Image } from 'astro:assets';
import handmadeIllustration from '../assets/decorations/handmade-squishies.png';
import originalIllustration from '../assets/decorations/original-squishies.png';
import mellojoyIllustration from '../assets/decorations/mellojoy-squishies.png';
import { featured } from '../data/featured';
import InstagramButton from './InstagramButton.astro';

const { handmade, original, mellojoy, photos } = featured;
---
<section id="featured" class="featured section-pad" aria-labelledby="featured-title">
  <div class="checker-trim" aria-hidden="true"></div>
  <div class="container">
    <div class="feature-split">
      <div>
        <p class="section-label"><span>02</span> 手作り体験</p>
        <div class="feature-heading-wrap">
          <p class="feature-script" aria-hidden="true">MAKE YOUR OWN SQUEEZE!</p>
          <div class="illustrated-heading">
            <h2 id="featured-title"><span>手作り</span><span>スクイーズ</span></h2>
            <Image
              class="decoration heading-illustration"
              src={handmadeIllustration}
              alt=""
              aria-hidden="true"
              widths={[240, 360, 640]}
              sizes="(max-width: 400px) 65vw, (max-width: 520px) 260px, (min-width: 901px) and (max-width: 1100px) 27vw, 320px"
              format="webp"
              loading="lazy"
              draggable="false"
            />
          </div>
        </div>
        <div class="feature-copy">
          <span class="feature-badge">{handmade.lead}</span>
          <p>{handmade.introduction}</p>
        </div>
      </div>
      <figure class="feature-photo-full">
        <a href={handmade.photo.image.src} data-photo data-caption={handmade.photo.alt} aria-label={`${handmade.photo.alt}（写真を拡大）`}>
          <Image src={handmade.photo.image} alt={handmade.photo.alt} widths={[400, 720, 1100]} sizes="(max-width: 520px) 90vw, 440px" format="webp" loading="lazy" />
          <span class="photo-zoom" aria-hidden="true">＋</span>
        </a>
      </figure>
    </div>
  </div>
</section>

<section id="original-squeeze" class="squeeze-brand section-pad" aria-labelledby="original-squeeze-title">
  <div class="container">
    <div class="feature-intro">
      <div>
        <p class="section-label"><span>03</span> 自社ブランド</p>
        <div class="feature-heading-wrap illustrated-heading">
          <h2 id="original-squeeze-title"><span>オリジナル</span><span>スクイーズ</span></h2>
          <Image
            class="decoration heading-illustration"
            src={originalIllustration}
            alt=""
            aria-hidden="true"
            widths={[240, 360, 640]}
            sizes="(max-width: 400px) 65vw, (max-width: 520px) 260px, 320px"
            format="webp"
            loading="lazy"
            draggable="false"
          />
        </div>
      </div>
      <div class="feature-copy">
        <p>{original.introduction}</p>
      </div>
    </div>
    <div class="feature-assortment">
      <h3>店頭のスクイーズ・関連商品</h3>
      <p>工場から直接仕入れたスクイーズや、開けるまで中身がわからないブラインドボックスも取りそろえています。写真は店頭商品の一例です。</p>
    </div>
    <div class="feature-gallery">
      {photos.map((photo) => (
        <figure class="feature-photo">
          <a href={photo.image.src} data-photo data-caption={photo.alt} aria-label={`${photo.alt}（写真を拡大）`}>
            <Image src={photo.image} alt={photo.alt} widths={[400, 720, 1100]} sizes="(max-width: 480px) 90vw, (max-width: 700px) 440px, (max-width: 1264px) 46vw, 540px" format="webp" loading="lazy" style={`object-position: ${photo.position}`} />
            <span class="photo-zoom" aria-hidden="true">＋</span>
          </a>
          <figcaption>{photo.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<section id="mellojoy" class="mellojoy section-pad" aria-labelledby="mellojoy-title">
  <div class="container">
    <div class="feature-split">
      <div>
        <p class="section-label"><span>04</span> スクイーズブランド</p>
        <div class="feature-heading-wrap">
          <p class="feature-script" aria-hidden="true">MELLOJOY</p>
          <div class="illustrated-heading">
            <h2 id="mellojoy-title"><span>メロジョイ</span></h2>
            <Image
              class="decoration heading-illustration"
              src={mellojoyIllustration}
              alt=""
              aria-hidden="true"
              widths={[240, 360, 640]}
              sizes="(max-width: 400px) 65vw, (max-width: 520px) 260px, (min-width: 901px) and (max-width: 1100px) 25vw, 320px"
              format="webp"
              loading="lazy"
              draggable="false"
            />
          </div>
        </div>
        <p class="mellojoy-description">{mellojoy.introduction}</p>
        <InstagramButton label="Instagramでスクイーズの最新情報を見る" />
      </div>
      <figure class="feature-photo-full">
        <a href={mellojoy.photo.image.src} data-photo data-caption={mellojoy.photo.alt} aria-label={`${mellojoy.photo.alt}（写真を拡大）`}>
          <Image src={mellojoy.photo.image} alt={mellojoy.photo.alt} widths={[400, 720, 1100]} sizes="(max-width: 520px) 90vw, 440px" format="webp" loading="lazy" />
          <span class="photo-zoom" aria-hidden="true">＋</span>
        </a>
      </figure>
    </div>
  </div>
</section>
