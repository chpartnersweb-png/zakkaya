---
interface Props { name: string; class?: string; }
const { name, class: className } = Astro.props;
---
<svg class={className} width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'instagram' && <><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none" /></>}
  {name === 'arrow' && <><path d="M5 12h14M13 6l6 6-6 6" /></>}
  {name === 'external' && <><path d="M7 17 17 7M7 7h10v10" /></>}
  {name === 'gift' && <><rect x="3" y="8" width="18" height="4" rx="1" /><path d="M5 12v9h14v-9M12 8v13" /><path d="M12 8C3 8 5 1 9 3c2 1 3 5 3 5Zm0 0c9 0 7-7 3-5-2 1-3 5-3 5Z" /></>}
  {name === 'card' && <><rect x="2" y="5" width="20" height="14" rx="2" /><path d="M2 9h20M6 15h3" /><path d="m16 12 .8 1.6 1.7.3-1.2 1.2.3 1.7-1.6-.8-1.6.8.3-1.7-1.2-1.2 1.7-.3Z" /></>}
  {name === 'truck' && <><path d="M2 5h12v12H2zM14 9h4l4 4v4h-8" /><circle cx="6" cy="18" r="2" /><circle cx="18" cy="18" r="2" /><path d="M14 13h8" /></>}
  {name === 'pin' && <><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></>}
  {name === 'flower' && <><path d="M12 7C7-2 0 6 7 10c-10 1-6 11 2 7 0 10 11 9 9 0 9 4 13-6 3-7 7-7-2-13-6-5Z" transform="translate(-1 0) scale(.94)" /><circle cx="11.5" cy="11.5" r="2.5" /></>}
  {name === 'sparkle' && <><path d="M12 2c0 7-3 10-10 10 7 0 10 3 10 10 0-7 3-10 10-10C15 12 12 9 12 2Z" /></>}
  {name === 'heart' && <><path d="M20 5c-3-3-7-1-8 2-1-3-5-5-8-2-5 5 3 11 8 15 5-4 13-10 8-15Z" /></>}
</svg>
